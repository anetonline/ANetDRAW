${EXEDIR}door.cfg: $(EXAMPLEDIR)data/door.cfg | ${EXEDIR}
	cp -f $< $@

${EXEDIR}DORINFO1.DEF: $(EXAMPLEDIR)data/DORINFO1.DEF | ${EXEDIR}
	cp -f $< $@

EXAMPLE_DATA := ${EXEDIR}door.cfg ${EXEDIR}DORINFO1.DEF

${EXEDIR}ex_chat${EXE_SUFFIX}: $(EXAMPLEDIR)ex_chat.c ${ODOORS_SHLIB} ${EXAMPLE_RUNTIME_DEP} ${EXAMPLE_DATA} | ${EXEDIR}
	$(CC) $(LDFLAGS) $(CFLAGS) $(EXAMPLEDIR)ex_chat.c -o $@ ${ODOORS_SHLIB}

${EXEDIR}ex_diag${EXE_SUFFIX}: $(EXAMPLEDIR)ex_diag.c ${ODOORS_SHLIB} ${EXAMPLE_RUNTIME_DEP} ${EXAMPLE_DATA} | ${EXEDIR}
	$(CC) $(LDFLAGS) $(CFLAGS) $(EXAMPLEDIR)ex_diag.c -o $@ ${ODOORS_SHLIB}

${EXEDIR}ex_hello${EXE_SUFFIX}: $(EXAMPLEDIR)ex_hello.c ${ODOORS_SHLIB} ${EXAMPLE_RUNTIME_DEP} ${EXAMPLE_DATA} | ${EXEDIR}
	$(CC) $(LDFLAGS) $(CFLAGS) $(EXAMPLEDIR)ex_hello.c -o $@ ${ODOORS_SHLIB}

${EXEDIR}ex_music${EXE_SUFFIX}: $(EXAMPLEDIR)ex_music.c ${ODOORS_SHLIB} ${EXAMPLE_RUNTIME_DEP} ${EXAMPLE_DATA} | ${EXEDIR}
	$(CC) $(LDFLAGS) $(CFLAGS) $(EXAMPLEDIR)ex_music.c -o $@ ${ODOORS_SHLIB}

${EXEDIR}ex_ski${EXE_SUFFIX}: $(EXAMPLEDIR)ex_ski.c ${ODOORS_SHLIB} ${EXAMPLE_RUNTIME_DEP} ${EXAMPLE_DATA} | ${EXEDIR}
	$(CC) $(LDFLAGS) $(CFLAGS) $(EXAMPLEDIR)ex_ski.c -o $@ ${ODOORS_SHLIB}

${EXEDIR}ex_vote${EXE_SUFFIX}: $(EXAMPLEDIR)ex_vote.c $(EXAMPLEDIR)ex_votio.c $(EXAMPLEDIR)ex_votio.h ${ODOORS_SHLIB} ${EXAMPLE_RUNTIME_DEP} ${EXAMPLE_DATA} | ${EXEDIR}
	$(CC) $(LDFLAGS) $(CFLAGS) $(EXAMPLEDIR)ex_vote.c $(EXAMPLEDIR)ex_votio.c -o $@ ${ODOORS_SHLIB} -DMULTINODE_AWARE
