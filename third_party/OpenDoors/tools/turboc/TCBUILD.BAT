if exist C:\TCBUILD.OK del C:\TCBUILD.OK
if exist C:\OUT\ODOORL.LIB del C:\OUT\ODOORL.LIB
cd \OBJ
echo Turbo C 2.01 OpenDoors diagnostic build>C:\TCBUILD.LOG
call C:\TCONE.BAT ODAUTO
